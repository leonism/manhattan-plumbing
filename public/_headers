# Headers configuration for Cloudflare Pages
# Defines response headers for specific paths to support agent discovery (RFC 8288)

/
  Link: </.well-known/api-catalog>; rel="api-catalog", </llms.txt>; rel="service-doc", </llms-full.txt>; rel="describedby"

/index.html
  Link: </.well-known/api-catalog>; rel="api-catalog", </llms.txt>; rel="service-doc", </llms-full.txt>; rel="describedby"

/.well-known/api-catalog
  Content-Type: application/linkset+json; charset=utf-8
  Access-Control-Allow-Origin: *

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
