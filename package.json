    "prettier-plugin-tailwindcss": "^0.8.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-helmet": "^6.1.0",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.75.0",
    "react-router-dom": "^7.15.0",
    "react-slick": "^0.30.3",
    "rehype-raw": "^7.0.0",
    "rehype-react": "^8.0.0",
    "rehype-stringify": "^10.0.1",
