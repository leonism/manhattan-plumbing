    "sharp": "^0.34.5",
    "svgo": "^4.0.0",
    "tailwindcss": "^4.3.0",
    "terser": "^5.47.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.11",
