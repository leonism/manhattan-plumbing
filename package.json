    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/typography": "^0.5.16",
    "@types/react-helmet": "^6.1.11",
    "@vercel/analytics": "^1.5.0",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
